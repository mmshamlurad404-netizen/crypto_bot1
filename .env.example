# ============================================================================
# Nobitex Sentiment Bot - configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info
# Label for this bot (log attribution; multi-bot mode sets it per entry).
BOT_NAME=default

# --- Exchange (Nobitex) ------------------------------------------------------
# Create a key in Nobitex settings -> API keys. Grant only the permissions the
# bot needs: READ (market/wallets) and TRADE only if you enable live trading.
# The bot always sends the key as "Authorization: Token <key>".
NOBITEX_API_KEY=
NOBITEX_BASE_URL=https://apiv2.nobitex.ir

# SAFETY SWITCHES - keep both ON for paper trading.
# DRY_RUN=true  -> fills are simulated, no real orders.
# TRADING_ENABLED=false -> bot evaluates and logs signals but never sends orders.
DRY_RUN=true
TRADING_ENABLED=false

# --- Portfolio / markets ----------------------------------------------------
# Quote currency used to value the portfolio (rls = Iranian rial, usdt).
QUOTE_CURRENCY=rls
# Tradable pairs, comma separated: src/dst. At least one must use the quote currency.
SYMBOLS=btc/rls,eth/rls
# Virtual starting equity for dry-run mode (in quote currency).
VIRTUAL_START_EQUITY=100000000

# --- Strategy (hybrid: sentiment + RSI) --------------------------------------
RSI_PERIOD=14
RSI_OVERBOUGHT=70
# RSI ceiling for entering (buy dips only, e.g. RSI < 35)
RSI_ENTRY_UPPER=35

# Sentiment threshold [-1..1]. Buy when aggregate sentiment >= ENTRY and RSI < ENTRY_UPPER.
SENTIMENT_ENTRY_THRESHOLD=0.3
# Exit when sentiment falls to EXIT while holding.
SENTIMENT_EXIT_THRESHOLD=-0.2
# Sentiment entries older than WINDOW are dropped; HALF_LIFE controls recency weighting.
SENTIMENT_WINDOW_HOURS=24
SENTIMENT_HALF_LIFE_HOURS=12
SENTIMENT_MIN_CONFIDENCE=0.1

# --- Sentiment ingestion -----------------------------------------------------
# The bot exposes a webhook that verified-account pipelines can POST sentiment to.
# Set to 0 to disable the HTTP server entirely (e.g. for secondary bots).
SENTIMENT_WEBHOOK_PORT=3001
# Bearer token required on POST /api/v1/sentiment (Authorization: Bearer <token>)
SENTIMENT_WEBHOOK_TOKEN=change-me-to-a-long-random-string
# Optional JSONL file feed (account|symbol|sentiment per line) watched for changes.
SENTIMENT_JSON_FEED=

# --- TradingView webhook -----------------------------------------------------
# When enabled, POST /api/v1/tradingview (same Bearer token) accepts TradingView
# alert payloads. The alert's action is mapped to a BUY/SELL intent that is
# processed on the next poll through the normal risk gates (halted/cooldown/
# volatility/exposure/trade-cap), then executed or logged. Off = endpoint 404s.
# Payload: {"symbol":"btc/rls","close":<price>,"strategy":{"order":{"action":"buy"}}}
#   - symbol: bot key like "btc/rls"; or ticker like "BINANCE:BTCRLS" (matched by
#     stripping the exchange prefix and comparing to src+dst, e.g. btc+rls -> BTCRLS)
#   - action: "buy"/"long" -> BUY, "sell"/"close"/"exit"/"short" -> SELL,
#     "hold"/"none" -> recorded as a no-op
TRADINGVIEW_ENABLED=false

# --- Data polling ------------------------------------------------------------
PRICE_POLL_SECONDS=60
SERIES_MAX_POINTS=500
SEED_SERIES_FROM_TRADES=true

# --- Risk management ---------------------------------------------------------
# Max % of equity per single position.
MAX_POSITION_SIZE_PCT=10
# Max total % of equity held across all open positions (avoid overexposure).
MAX_TOTAL_EXPOSURE_PCT=40
# Halt trading for the day if equity drops more than this % vs previous day.
MAX_DAILY_LOSS_PCT=3
# Max number of trades per day.
MAX_TRADES_PER_DAY=6
# Minimum order value in quote currency (rejects dust orders).
MIN_ORDER_VALUE=5000000
# Reject entries when per-sample volatility exceeds this (e.g. 0.05 = 5%).
VOLATILITY_MAX=0.05
# Volatility benchmark used to scale position size down on volatile assets.
VOLATILITY_BENCHMARK=0.02
# Cap on how much size can be scaled up for low-volatility assets.
VOLATILITY_SIZE_CAP=2.0
# Stop-loss and take-profit in % from entry.
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
# Trailing stop-loss: 0 disables. Once price is >= ACTIVATE % above entry, the
# stop ratchets up with the peak and exits on a trailingStopPct pullback.
TRAILING_STOP_PCT=0
TRAILING_STOP_ACTIVATE_PCT=1.5
# Trailing take-profit: 0 disables. Once price is >= ACTIVATE % above entry the
# fixed take-profit is superseded by a peak-trailing exit (trailingTpPct below
# the peak), letting winners run. Keep ACTIVATE <= TAKE_PROFIT_PCT to take effect.
TRAILING_TP_PCT=0
TRAILING_TP_ACTIVATE_PCT=2
# Minutes to wait before re-entering the same symbol after a trade.
COOLDOWN_MINUTES=30

# --- DCA (dollar-cost averaging / averaging down) -----------------------------
# When enabled, an open position that drops below the avg entry can be topped
# up instead of just riding the loss. Levels are consumed in order as price
# falls; each level buys buyPct% of equity and passes the normal risk gates
# (open-position gate skipped, cooldown/trade-cap still apply). The avg entry
# is recomputed after each fill. 0 disables.
DCA_ENABLED=false
# Max DCA fills per position (hard cap, independent of level count).
DCA_MAX_ORDERS_PER_POSITION=4
# JSON array, sorted by belowPct automatically:
# [{"belowPct":5,"buyPct":5},{"belowPct":10,"buyPct":5},{"belowPct":15,"buyPct":10}]
DCA_LEVELS=[]

# --- Trigger rules (rule DSL) -------------------------------------------------
# Declarative conditions -> actions, evaluated every tick BEFORE the strategy.
# Conditions: rsi_below|rsi_above, price_below|price_above, sentiment_below|sentiment_above,
#             volatility_below|volatility_above (fraction, e.g. 0.02),
#             atr_pct_below|atr_pct_above (close-range proxy in %), stoch_k_/stoch_d_ below|above (0..100),
#             macd_hist_pct_below|macd_hist_pct_above (MACD histogram as % of price, 12/26/9)
# Actions:    notify (Telegram alert) | halt (halt trading for the day)
# A rule fires once when its condition goes false->true (edge triggered).
#   [{"id":"btc-dip","symbol":"btc/rls","when":{"type":"rsi_below","value":25},"then":{"type":"notify","message":"BTC oversold!"}},
#    {"id":"global-halt","symbol":"eth/rls","when":{"type":"price_below","value":200000},"then":{"type":"halt"}},
#    {"id":"trend","symbol":"btc/rls","when":{"type":"macd_hist_pct_above","value":0},"then":{"type":"notify"}}]
TRIGGERS=[]

# --- Strategy pool (per-symbol strategy assignment) ---------------------------
# Optional JSON object mapping symbol -> strategy. Each value is either the
# string "hybrid" (default) or a DSL strategy object:
#   {"entry":{"and":[{"sentiment_gt":0.3},{"rsi_lt":35}]},"exit":{"or":[{"rsi_gt":70},{"sentiment_lt":-0.2}]}}
# DSL nodes: rsi_lt|rsi_gt, volatility_lt|volatility_gt, sentiment_lt|sentiment_gt,
#            price_gt_ma|price_lt_ma ({"kind":"sma"|"ema","period":N}),
#            macd_hist_pct_lt|macd_hist_pct_gt (MACD histogram as % of price),
#            stoch_k_/stoch_d_ lt|gt (0..100), atr_pct_lt|atr_pct_gt (close-range proxy %),
#            boll_pct_lt|boll_pct_gt (price vs 20-bar mid band as %, e.g. +3 above / -3 below),
#            and:[...], or:[...], not:node, warmupSamples:N (optional)
# Advanced nodes use fixed lookbacks (MACD 12/26/9, Bollinger 20/2, stoch 14/3, ATR-proxy 14)
# and need ~45 bars of warmup before they can fire.
# Symbols not listed use the hybrid strategy. Empty -> hybrid for everything.
#   {"btc/rls":"hybrid","eth/rls":{"entry":{"sentiment_gt":0.2},"exit":{"rsi_gt":75}}}
#   {"btc/rls":{"entry":{"and":[{"price_gt_ma":{"kind":"ema","period":21}},{"macd_hist_pct_gt":0}]}}}
STRATEGY_POOLS={}
# --- AI advisor (LLM-driven strategy) -----------------------------------------
# Use the string "ai" in STRATEGY_POOLS to assign the LLM advisor to a symbol,
# e.g. STRATEGY_POOLS='{"btc/rls":"ai"}'. It is OFF unless the symbol is
# assigned AND USER_LLM_API_KEY is set (config validation rejects "ai" without
# a key). On every decision window it sends a JSON snapshot (last bars, RSI,
# volatility, MAs, sentiment, position, risk limits) to an OpenAI-compatible
# /chat/completions endpoint and maps BUY/SELL/HOLD to intents. BUY goes
# through the same risk gates (skipping the hybrid RSI ceiling); SELL requires
# an open position; errors/holds/throttles always fall back to HOLD.
#   USER_LLM_API_KEY=your-key-here
#   USER_LLM_BASE_URL=https://api.deepseek.com/v1
#   USER_LLM_MODEL=deepseek-chat
# Minimum seconds between LLM calls per symbol (rate/$$ throttle).
AI_ADVISOR_MIN_INTERVAL_SECONDS=300
# Number of trailing close bars included in the snapshot sent to the LLM.
AI_ADVISOR_CONTEXT_BARS=40

# --- Short selling via margin API (default OFF) --------------------------------
# Enables SHORT (open short) / COVER (close short) decisions from the hybrid
# strategy: a short is opened when RSI >= RSI_OVERBOUGHT and sentiment is
# below -SENTIMENT_ENTRY_THRESHOLD; it is covered when sentiment turns bullish,
# RSI drops to RSI_ENTRY_UPPER, or margin stop/take-profit/trailing hits
# (inverted directions: stop-loss when the price RISES above entry). Orders go
# through the Nobitex margin endpoints (/v2/margin, /v2/margin/orders/add,
# /v2/margin/orders/close). Keep OFF unless you understand margin risk.
MARGIN_ENABLED=false
# Leverage used when opening a short (1..10).
MARGIN_LEVERAGE=2
# Max short notional as % of equity (like MAX_POSITION_SIZE_PCT but for shorts).
MARGIN_MAX_SHORT_PCT=10
# Optional comma list of symbols allowed to short; empty = all SYMBOLS.
MARGIN_SYMBOLS=
# Short stop-loss % (price rising above entry triggers COVER).
MARGIN_STOP_LOSS_PCT=3
# Short take-profit % (price falling below entry triggers COVER).
MARGIN_TAKE_PROFIT_PCT=6
# Minimum RSI required for a short entry (safety gate on top of RSI_OVERBOUGHT).
RSI_SHORT_ENTRY_FLOOR=65
# Assumed taker fee % used for PnL accounting.
FEE_PCT=0.25

# --- Market making (resting quotes) (default OFF) ------------------------------
# Places passive limit orders around the mid price on the Nobitex order book for
# each enabled symbol: a bid when no inventory exists, then both a bid and an
# ask after a fill. Quotes are inventory-aware (the bid is skewed/suppressed as
# inventory approaches MM_MAX_INVENTORY_VALUE), refreshed when they age past
# MM_MAX_QUOTE_AGE_SECONDS, gated by a fill cooldown, and stopped out via a
# market sell if the mid drops MM_STOP_LOSS_PCT below cost. All fills flow
# through the normal risk/portfolio/audit pipeline. Keep OFF unless you want to
# hold inventory while collecting the spread.
MM_ENABLED=false
# Optional comma list of symbols to make markets in; empty = all SYMBOLS.
MM_SYMBOLS=
# Half of the total quote distance around the mid (e.g. 0.5 -> quotes at mid +/-0.25%).
MM_SPREAD_PCT=0.5
# Quote notional per side in quote currency (RIALS/USDT).
MM_ORDER_VALUE=10000000
# Cap on inventory notional; the bid shrinks to 0 as inventory approaches this.
MM_MAX_INVENTORY_VALUE=20000000
# Stop-loss % below cost basis: a market sell closes inventory when hit.
MM_STOP_LOSS_PCT=3
# Seconds to wait after a fill before placing fresh quotes.
MM_COOLDOWN_SECONDS=60
# Seconds after which an unfilled resting quote is cancelled and re-quoted.
MM_MAX_QUOTE_AGE_SECONDS=300
# Minimum notional for a quote to be placed (filters dust quotes).
MM_MIN_ORDER_VALUE=5000000
# Assign per-symbol with STRATEGY_POOLS (see above), e.g. {"btc/rls":"mm"}.
# Without an assignment the MM config above is not used.

# --- Cross-exchange arbitrage (Nobitex <-> external) (default OFF) -------------
# Detects bid/ask dislocations between a Nobitex symbol and the same asset on an
# external exchange (Binance) and, when the fee-adjusted round trip clears
# ARB_MIN_PROFIT_PCT, simulates (dry-run) or executes (live) the two legs as
# plain spot round trips: e.g. buy on Nobitex, sell on the arb exchange (or the
# reverse). Legs land in the normal Nobitex spot wallet; there is no separate
# holding account. Executed legs use a real-market USD/RIALS or USDT/RIALS
# conversion via ARB_FX_RATE if quoted in a different currency.
ARB_ENABLED=false
# External exchange to trade against ("binance").
ARB_EXCHANGE=binance
# JSON map of local symbol -> external symbol, e.g. {"btc/rls":"btcusdt"}.
ARB_SYMBOLS={}
# Fixed conversion rate applied to external prices (0 -> treated as 1). Set when
# comparing RIALS-priced Nobitex prices to a USD/USDT-priced external book.
ARB_FX_RATE=0
# Minimum fee-adjusted round-trip profit % required before trading.
ARB_MIN_PROFIT_PCT=0.5
# Max notional of one arb leg as % of equity.
ARB_MAX_NOTIONAL_PCT=5
# Seconds between attempts for the same symbol after a completed round trip.
ARB_COOLDOWN_SECONDS=300
# Credentials for the external exchange. Required (and validated) only when
# ARB_ENABLED=true AND DRY_RUN=false.
USER_ARB_API_KEY=
USER_ARB_API_SECRET=

# --- Restart safety & reconciliation -----------------------------------------
# On boot the bot re-polls every resting order that was still open when it last
# stopped ("boot recovery") and books fills that happened while it was down
# (risk halts, trailing-stop ratchets, MM inventory/cost basis and resting quote
# ids are persisted to the DB meta table and rehydrated, so a restart does not
# forget a daily-loss halt or a trailing peak). Orders left resting by market
# makers are re-adopted and re-quoted. Dry-run and live order rows never mix.
#
# Run a manual reconcile of the DB (open positions - resting sells) against the
# real exchange wallet, exiting non-zero when drift is found:
#   npm run reconcile
# Requires DRY_RUN=false and a live NOBITEX_API_KEY. It does not trade.

# --- Multi-bot orchestration ---------------------------------------------------
# Run several independent bots in ONE process (Bulk Bot Manager analogue).
# Each entry is an env-override object merged over the base .env, so anything
# here can differ per bot (SYMBOLS, DB_PATH, STRATEGY_POOLS, risk knobs, ...).
# Give each bot its own DB_PATH and a unique SENTIMENT_WEBHOOK_PORT, or set the
# port to 0 to disable its webhook. When unset, a single bot runs as usual.
#   [{"BOT_NAME":"btc-bot","SYMBOLS":"btc/rls","DB_PATH":"./data/bot-btc.db","SENTIMENT_WEBHOOK_PORT":3001},
#    {"BOT_NAME":"eth-bot","SYMBOLS":"eth/rls","DB_PATH":"./data/bot-eth.db","SENTIMENT_WEBHOOK_PORT":0}]
BOTS_JSON=

# --- Alerts ------------------------------------------------------------------
# Telegram bot token from @BotFather and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily report time (HH:MM, server local time).
DAILY_REPORT_TIME=08:00

# --- Audit database ----------------------------------------------------------
DB_PATH=./data/audit.db
